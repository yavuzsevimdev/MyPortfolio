@model Experience
@{
    Layout = "~/Views/Layout/Index.cshtml";
}


<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Deneyimler</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Deneyim Ekleme Sayfası</div>
                    </div>
                    <div class="card-body">
                        <div class="card-sub">
                            Deneyimler ile ilgili ekleme işlemini aşağıdaki panelden yapabilirsiniz.
                        </div>

                        <form method="post">
                            <input type="text" asp-for="Head" class="form-control" placeholder="Deneyim Başlığı & Firma Bilgisi" />
                            <br />
                            <input type="text" asp-for="Title" class="form-control" placeholder="Çalışılan Pozisyon" />
                            <br />
                            <input type="text" asp-for="Date" class="form-control" placeholder="Tarih Aralığı" />
                            <br />
                            <textarea asp-for="Description" rows="5" class="form-control" placeholder="Açıklama" ></textarea>
                            <br />
                            <button class="btn btn-primary">Deneyimi Ekle</button>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
