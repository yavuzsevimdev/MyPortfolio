@model List<Skill>

<div class="col-six tab-full right">
    <h3>Programlama Dilleri & Teknolojiler.</h3>

    <ul class="skill-bars">
        @foreach (var item in Model)
        {
            string className = $"progress percent{item.Value}";
            <li>
                <div class="@className"><span>@item.Value%</span></div>
                <strong>@item.Title</strong>
            </li>
        }
    </ul>
</div>
