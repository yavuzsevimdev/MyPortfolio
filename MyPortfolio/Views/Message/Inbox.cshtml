@model List<Message>
@{
    Layout = "~/Views/Layout/Index.cshtml";
    int count = 0;
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Mesajlar</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Gelen Mesajlar Listesi</div>
                    </div>
                    <div class="card-body">
                        <div class="card-sub">
                            Mesajlar ile ilgili işlemleri aşağıdaki panelden yapabilirsiniz.
                        </div>
                        <table class="table mt-3">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Gönderen</th>
                                    <th scope="col">Konu</th>
                                    <th scope="col">Tarih</th>
                                    <th scope="col">Mesajı Aç</th>
                                    <th scope="col">Durum Değiştir</th>
                                    <th scope="col">Sil</th>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            count++;
                                            <tr>
                                                <td>@count</td>
                                                <td>@item.NameSurname</td>
                                                <td>@item.Subject</td>
                                                <td>@item.SendDate.ToShortDateString()</td>
                                                <td>
                                                <a href="/Message/MessageDetail/@item.MessageId" class="btn btn-outline-warning">Mesajı Aç</a>
                                                </td>
                                                @if (item.IsRead == true)
                                                {
                                                    <td>
                                                        <a href="/Message/ChangeIsReadToFalse/@item.MessageId" class="btn btn-outline-info">Okunmadı olarak işaretle</a>
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td>
                                                        <a href="/Message/ChangeIsReadToTrue/@item.MessageId" class="btn btn-outline-dark">Okundu olarak işaretle</a>
                                                    </td>
                                                }
                                                <td>
                                                    <a href="/Message/DeleteMessage/@item.MessageId" class="btn btn-danger">Sil</a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>

                                </table>
                                <a href="/Experience/CreateExperience" class="btn btn-primary">Yeni Mesaj Girişi</a>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
